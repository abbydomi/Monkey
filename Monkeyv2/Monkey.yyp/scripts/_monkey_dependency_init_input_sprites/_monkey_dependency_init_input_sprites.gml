function _monkey_dependency_init_input_sprites() {
    global._monkey_gp_sprites_xbox = ds_map_create()
    global._monkey_gp_sprites_other = ds_map_create()
    global._monkey_vk_sprites = ds_map_create()
    
    global._monkey_gp_sprites_xbox[? gp_face1]      = xbox_A
    global._monkey_gp_sprites_xbox[? gp_face2]      = xbox_B
    global._monkey_gp_sprites_xbox[? gp_face3]      = xbox_X
    global._monkey_gp_sprites_xbox[? gp_face4]      = xbox_Y
    global._monkey_gp_sprites_xbox[? gp_padd]       = xbox_dpaddown
    global._monkey_gp_sprites_xbox[? gp_padl]       = xbox_dpadleft
    global._monkey_gp_sprites_xbox[? gp_padr]       = xbox_dpadright
    global._monkey_gp_sprites_xbox[? gp_padu]       = xbox_dpadup
    global._monkey_gp_sprites_xbox[? gp_shoulderl]  = xbox_L
    global._monkey_gp_sprites_xbox[? gp_shoulderlb] = xbox_LT
    global._monkey_gp_sprites_xbox[? gp_shoulderr]  = xbox_R
    global._monkey_gp_sprites_xbox[? gp_shoulderrb] = xbox_RT
    global._monkey_gp_sprites_xbox[? gp_start]      = xbox_start
    global._monkey_gp_sprites_xbox[? gp_select]     = xbox_select
    global._monkey_gp_sprites_xbox[? gp_stickl]     = both_R3
    global._monkey_gp_sprites_xbox[? gp_stickr]     = both_L3
    
    global._monkey_gp_sprites_other[? gp_face1]      = ds4_X
    global._monkey_gp_sprites_other[? gp_face2]      = ds4_circle
    global._monkey_gp_sprites_other[? gp_face3]      = ds4_square
    global._monkey_gp_sprites_other[? gp_face4]      = ds4_triangle
    global._monkey_gp_sprites_other[? gp_padd]       = ds4_dpaddown
    global._monkey_gp_sprites_other[? gp_padl]       = ds4_dpadleft
    global._monkey_gp_sprites_other[? gp_padr]       = ds4_dpadright
    global._monkey_gp_sprites_other[? gp_padu]       = ds4_dpadup
    global._monkey_gp_sprites_other[? gp_shoulderl]  = ds4_l1
    global._monkey_gp_sprites_other[? gp_shoulderlb] = ds4_l2
    global._monkey_gp_sprites_other[? gp_shoulderr]  = ds4_r1
    global._monkey_gp_sprites_other[? gp_shoulderrb] = ds4_r2
    global._monkey_gp_sprites_other[? gp_start]      = ds4_options
    global._monkey_gp_sprites_other[? gp_select]     = ds4_share
    global._monkey_gp_sprites_other[? gp_stickl]     = both_R3
    global._monkey_gp_sprites_other[? gp_stickr]     = both_L3
    
    global._monkey_vk_sprites[? vk_alt]       = key_alt
    global._monkey_vk_sprites[? vk_backspace] = key_backspace
    global._monkey_vk_sprites[? vk_control]   = key_ctrl
    global._monkey_vk_sprites[? vk_shift]     = key_shift
    global._monkey_vk_sprites[? vk_delete]    = key_backspace
    global._monkey_vk_sprites[? vk_down]      = key_arrowdown
    global._monkey_vk_sprites[? vk_end]       = key_enter
    global._monkey_vk_sprites[? vk_escape]    = key_esc
    global._monkey_vk_sprites[? vk_enter]     = key_enter
    global._monkey_vk_sprites[? vk_insert]    = key_enter
    global._monkey_vk_sprites[? vk_left]      = key_arrowleft
    global._monkey_vk_sprites[? vk_lshift]    = key_shift
    global._monkey_vk_sprites[? vk_rshift]    = key_shift
    global._monkey_vk_sprites[? vk_lcontrol]  = key_ctrl
    global._monkey_vk_sprites[? vk_rcontrol]  = key_ctrl
    global._monkey_vk_sprites[? vk_lalt]      = key_alt
    global._monkey_vk_sprites[? vk_ralt]      = key_alt
    global._monkey_vk_sprites[? vk_right]     = key_arrowright
    global._monkey_vk_sprites[? vk_space]     = key_spacebar
    global._monkey_vk_sprites[? vk_tab]       = key_tab
    global._monkey_vk_sprites[? vk_up]        = key_arrowup
    global._monkey_vk_sprites[? vk_f1]        = key_F1
