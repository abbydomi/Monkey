    global._monkey_vk_sprites[? vk_f11]       = key_F11
    global._monkey_vk_sprites[? vk_f12]       = key_F12
    global._monkey_vk_sprites[? vk_numpad0]   = key_0
    global._monkey_vk_sprites[? vk_numpad1]   = key_1
    global._monkey_vk_sprites[? vk_numpad2]   = key_2
    global._monkey_vk_sprites[? vk_numpad3]   = key_3
    global._monkey_vk_sprites[? vk_numpad4]   = key_4
    global._monkey_vk_sprites[? vk_numpad5]   = key_5
    global._monkey_vk_sprites[? vk_numpad6]   = key_6
    global._monkey_vk_sprites[? vk_numpad7]   = key_7
    global._monkey_vk_sprites[? vk_numpad8]   = key_8
    global._monkey_vk_sprites[? vk_numpad9]   = key_9
    global._monkey_vk_sprites[? ord("A")]     = key_A
    global._monkey_vk_sprites[? ord("B")]     = key_B
    global._monkey_vk_sprites[? ord("C")]     = key_C
